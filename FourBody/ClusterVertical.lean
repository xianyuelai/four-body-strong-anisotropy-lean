import FourBody.Cuts
import FourBody.ClusterGap
import FourBody.Reuse.NewtonBounds
import Mathlib.Analysis.Convex.Hull

/-!
Formalization of actual v2 Proposition 2.2, lines 278--300.
Baseline SHA256:
97F112DD59B8737FA12B4933067FF404335F41F5640E0FFDBBF74A5D9FDCFFBD.
The actual force is split into a sum over J and the Newtonian field
generated by its complement. No cluster-scale estimate is assumed.
The explicit Lipschitz premise is an auxiliary hypothesis to be supplied
by the separately verified external Newtonian-field estimate.
Actual build and audit evidence is recorded separately. The same finite
sum mechanisms checked in FourBodyCuts are reused with J in place of univ.
-/

noncomputable section
open scoped BigOperators

namespace FourBody.ClusterVertical

def internalForce (m : Masses) (q : Configuration) (J : Finset Label)
    (i : Label) : Point :=
  ∑ j ∈ J.erase i, (m j / dist (q i) (q j) ^ 3) • (q i - q j)

def externalField (m : Masses) (q : Configuration) (J : Finset Label)
    (z : Point) : Point :=
  ∑ j ∈ cutComplement J, (m j / dist z (q j) ^ 3) • (z - q j)

def externalConfiguration (m : Masses) (q : Configuration) (J : Finset Label) :
    Configuration := fun i => externalField m q J (q i)

def hull (q : Configuration) (J : Finset Label) : Set Point :=
  convexHull ℝ (q '' (J : Set Label))

def LipschitzOnHull (m : Masses) (q : Configuration) (J : Finset Label)
    (L : ℝ) : Prop :=
  ∀ z ∈ hull q J, ∀ w ∈ hull q J,
    dist (externalField m q J z) (externalField m q J w) ≤ L * dist z w

def internalCrossForce (m : Masses) (q : Configuration) (k : Axis)
    (J A : Finset Label) : ℝ :=
  ∑ i ∈ A, ∑ j ∈ J \ A,
    (m i * m j / dist (q i) (q j) ^ 3) * (q j k - q i k)

def crossGap (m : Masses) (q : Configuration) (k : Axis)
    (A B : Finset Label) : ℝ :=
  ∑ i ∈ A, ∑ j ∈ B, m i * m j * (q j k - q i k)

theorem body_mem_hull (q : Configuration) (J : Finset Label)
    {i : Label} (hi : i ∈ J) : q i ∈ hull q J :=
  subset_convexHull ℝ _ ⟨i, hi, rfl⟩

theorem force_eq_full_sum (m : Masses) (q : Configuration) (i : Label) :
    force m q i = ∑ j, (m j / dist (q i) (q j) ^ 3) • (q i - q j) := by
  have h := Finset.sum_erase_add Finset.univ
    (fun j => (m j / dist (q i) (q j) ^ 3) • (q i - q j)) (Finset.mem_univ i)
  simpa only [sub_self, smul_zero, add_zero, force] using h

theorem internalForce_eq_sum (m : Masses) (q : Configuration) (J : Finset Label)
    {i : Label} (hi : i ∈ J) :
    internalForce m q J i = ∑ j ∈ J,
      (m j / dist (q i) (q j) ^ 3) • (q i - q j) := by
  have h := Finset.sum_erase_add J
    (fun j => (m j / dist (q i) (q j) ^ 3) • (q i - q j)) hi
  simpa only [sub_self, smul_zero, add_zero, internalForce] using h

/-- Exact original force decomposition on every actual body in J. -/
theorem force_decomposition (m : Masses) (q : Configuration) (J : Finset Label)
    {i : Label} (hi : i ∈ J) :
    force m q i = internalForce m q J i + externalField m q J (q i) := by
  rw [force_eq_full_sum, internalForce_eq_sum m q J hi]
  unfold externalField cutComplement
  rw [add_comm]
  exact (Finset.sum_sdiff (Finset.subset_univ J)).symm

theorem internalForce_coordinate (m : Masses) (q : Configuration) (J : Finset Label)
    (k : Axis) (i : Label) :
    internalForce m q J i k = ∑ j ∈ J.erase i,
      (m j / dist (q i) (q j) ^ 3) * (q i k - q j k) := by
  change coordinateLM k (∑ j ∈ J.erase i,
    (m j / dist (q i) (q j) ^ 3) • (q i - q j)) = _
  rw [map_sum]
  rfl

theorem weighted_internal_coordinate (m : Masses) (q : Configuration)
    (J : Finset Label) (k : Axis) {i : Label} (hi : i ∈ J) :
    m i * internalForce m q J i k = ∑ j ∈ J, coordinatePair m q k i j := by
  have h := Finset.sum_erase_add J (coordinatePair m q k i) hi
  rw [coordinatePair_self, add_zero] at h
  rw [internalForce_coordinate, Finset.mul_sum, ← h]
  apply Finset.sum_congr rfl
  intro j hj
  unfold coordinatePair
  ring

theorem weighted_internal_zero (m : Masses) (q : Configuration)
    (J : Finset Label) (k : Axis) :
    (∑ i ∈ J, m i * internalForce m q J i k) = 0 := by
  calc
    (∑ i ∈ J, m i * internalForce m q J i k) =
        ∑ i ∈ J, ∑ j ∈ J, coordinatePair m q k i j := by
      apply Finset.sum_congr rfl
      intro i hi
      exact weighted_internal_coordinate m q J k hi
    _ = 0 := internal_coordinate_pair_sum_zero m q k J

theorem weighted_lower_internal (m : Masses) (q : Configuration) (k : Axis)
    (J A : Finset Label) (hAJ : A ⊆ J) :
    (∑ i ∈ A, m i * internalForce m q J i k) =
      -internalCrossForce m q k J A := by
  have hsplit (i : Label) : (∑ j ∈ J, coordinatePair m q k i j) =
      (∑ j ∈ J \ A, coordinatePair m q k i j) +
        ∑ j ∈ A, coordinatePair m q k i j := (Finset.sum_sdiff hAJ).symm
  calc
    (∑ i ∈ A, m i * internalForce m q J i k) =
        ∑ i ∈ A, ∑ j ∈ J, coordinatePair m q k i j := by
      apply Finset.sum_congr rfl
      intro i hi
      exact weighted_internal_coordinate m q J k (hAJ hi)
    _ = (∑ i ∈ A, ∑ j ∈ J \ A, coordinatePair m q k i j) +
          ∑ i ∈ A, ∑ j ∈ A, coordinatePair m q k i j := by
      simp_rw [hsplit]
      rw [Finset.sum_add_distrib]
    _ = -internalCrossForce m q k J A := by
      rw [internal_coordinate_pair_sum_zero m q k A, add_zero]
      unfold internalCrossForce
      rw [← Finset.sum_neg_distrib]
      apply Finset.sum_congr rfl
      intro i hi
      rw [← Finset.sum_neg_distrib]
      apply Finset.sum_congr rfl
      intro j hj
      unfold coordinatePair
      ring

theorem weighted_upper_internal (m : Masses) (q : Configuration) (k : Axis)
    (J A : Finset Label) (hAJ : A ⊆ J) :
    (∑ i ∈ J \ A, m i * internalForce m q J i k) =
      internalCrossForce m q k J A := by
  have htotal : (∑ i ∈ J \ A, m i * internalForce m q J i k) +
      (∑ i ∈ A, m i * internalForce m q J i k) = 0 := by
    rw [show (∑ i ∈ J \ A, m i * internalForce m q J i k) +
        (∑ i ∈ A, m i * internalForce m q J i k) =
          ∑ i ∈ J, m i * internalForce m q J i k from Finset.sum_sdiff hAJ]
    exact weighted_internal_zero m q J k
  rw [weighted_lower_internal m q k J A hAJ] at htotal
  linarith

theorem mass_partition (m : Masses) (J A : Finset Label) (hAJ : A ⊆ J) :
    cutMass m A + cutMass m (J \ A) = cutMass m J := by
  unfold cutMass
  rw [add_comm]
  exact Finset.sum_sdiff hAJ

/-- The actual vertical equation with the complement field separated. -/
theorem solution_internal_vertical {m : Masses} {q : Configuration} {s : ℝ}
    (hq : IsSolution m s q) (J : Finset Label) {i : Label} (hi : i ∈ J) :
    internalForce m q J i 1 = q i 1 - externalConfiguration m q J i 1 := by
  have h := congrArg (fun p : Point => p 1) (hq.2 i)
  rw [force_decomposition m q J hi] at h
  change internalForce m q J i 1 + externalConfiguration m q J i 1 = _ at h
  rw [anisotropy_y] at h
  linarith

/-- The exact mass-averaged vertical equation of v2 lines 283--290. -/
theorem mean_vertical_equation {m : Masses} {q : Configuration} {s : ℝ}
    (hq : IsSolution m s q) (J A : Finset Label) (hAJ : A ⊆ J) :
    cutMean m q 1 (J \ A) - cutMean m q 1 A =
      (1 / cutMass m A + 1 / cutMass m (J \ A)) * internalCrossForce m q 1 J A +
        cutMean m (externalConfiguration m q J) 1 (J \ A) -
          cutMean m (externalConfiguration m q J) 1 A := by
  have hlower : cutMoment m q 1 A - cutMoment m (externalConfiguration m q J) 1 A =
      -internalCrossForce m q 1 J A := by
    rw [← weighted_lower_internal m q 1 J A hAJ]
    unfold cutMoment
    rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro i hi
    rw [solution_internal_vertical hq J (hAJ hi)]
    ring
  have hupper : cutMoment m q 1 (J \ A) -
      cutMoment m (externalConfiguration m q J) 1 (J \ A) =
        internalCrossForce m q 1 J A := by
    rw [← weighted_upper_internal m q 1 J A hAJ]
    unfold cutMoment
    rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro i hi
    rw [solution_internal_vertical hq J (Finset.mem_sdiff.mp hi).1]
    ring
  have hMA : cutMoment m q 1 A = -internalCrossForce m q 1 J A +
      cutMoment m (externalConfiguration m q J) 1 A := by linarith
  have hMB : cutMoment m q 1 (J \ A) = internalCrossForce m q 1 J A +
      cutMoment m (externalConfiguration m q J) 1 (J \ A) := by linarith
  unfold cutMean
  rw [hMA, hMB]
  ring

theorem crossGap_identity (m : Masses) (q : Configuration) (k : Axis)
    (A B : Finset Label) :
    crossGap m q k A B = cutMass m A * cutMoment m q k B -
      cutMoment m q k A * cutMass m B := by
  unfold crossGap
  calc
    (∑ i ∈ A, ∑ j ∈ B, m i * m j * (q j k - q i k)) =
        ∑ i ∈ A, ∑ j ∈ B, (m i * (m j * q j k) - (m i * q i k) * m j) := by
      apply Finset.sum_congr rfl
      intro i hi
      apply Finset.sum_congr rfl
      intro j hj
      ring
    _ = (∑ i ∈ A, m i) * (∑ j ∈ B, m j * q j k) -
        (∑ i ∈ A, m i * q i k) * (∑ j ∈ B, m j) := by
      simp_rw [Finset.sum_sub_distrib]
      rw [← Finset.sum_mul_sum, ← Finset.sum_mul_sum]
    _ = _ := rfl

theorem mean_difference_identity {m : Masses} (hm : PositiveMasses m)
    (q : Configuration) (k : Axis) {A B : Finset Label}
    (hA : A.Nonempty) (hB : B.Nonempty) :
    cutMean m q k B - cutMean m q k A =
      crossGap m q k A B / (cutMass m A * cutMass m B) := by
  have hMA := ne_of_gt (cutMass_pos hm hA)
  have hMB := ne_of_gt (cutMass_pos hm hB)
  rw [crossGap_identity]
  unfold cutMean
  field_simp [hMA, hMB]

theorem mean_difference_lower {m : Masses} (hm : PositiveMasses m)
    (q : Configuration) (k : Axis) {A B : Finset Label}
    (hA : A.Nonempty) (hB : B.Nonempty) {C : ℝ}
    (hgap : ∀ i ∈ A, ∀ j ∈ B, C ≤ q j k - q i k) :
    C ≤ cutMean m q k B - cutMean m q k A := by
  have hp : 0 < cutMass m A * cutMass m B :=
    mul_pos (cutMass_pos hm hA) (cutMass_pos hm hB)
  rw [mean_difference_identity hm q k hA hB]
  apply (le_div_iff₀ hp).mpr
  calc
    C * (cutMass m A * cutMass m B) = ∑ i ∈ A, ∑ j ∈ B, m i * m j * C := by
      rw [mul_comm C]
      unfold cutMass
      rw [Finset.sum_mul_sum]
      simp only [Finset.sum_mul]
    _ ≤ crossGap m q k A B := by
      apply Finset.sum_le_sum
      intro i hi
      apply Finset.sum_le_sum
      intro j hj
      exact mul_le_mul_of_nonneg_left (hgap i hi j hj) (mul_nonneg (hm i).le (hm j).le)

theorem mean_difference_upper {m : Masses} (hm : PositiveMasses m)
    (q : Configuration) (k : Axis) {A B : Finset Label}
    (hA : A.Nonempty) (hB : B.Nonempty) {C : ℝ}
    (hgap : ∀ i ∈ A, ∀ j ∈ B, q j k - q i k ≤ C) :
    cutMean m q k B - cutMean m q k A ≤ C := by
  have hp : 0 < cutMass m A * cutMass m B :=
    mul_pos (cutMass_pos hm hA) (cutMass_pos hm hB)
  rw [mean_difference_identity hm q k hA hB]
  apply (div_le_iff₀ hp).mpr
  calc
    crossGap m q k A B ≤ ∑ i ∈ A, ∑ j ∈ B, m i * m j * C := by
      apply Finset.sum_le_sum
      intro i hi
      apply Finset.sum_le_sum
      intro j hj
      exact mul_le_mul_of_nonneg_left (hgap i hi j hj) (mul_nonneg (hm i).le (hm j).le)
    _ = C * (cutMass m A * cutMass m B) := by
      rw [mul_comm C]
      unfold cutMass
      rw [Finset.sum_mul_sum]
      simp only [Finset.sum_mul]

theorem external_coordinate_difference_bound {m : Masses} {q : Configuration}
    {J : Finset Label} {L r : ℝ} (hL : 0 ≤ L)
    (hLip : LipschitzOnHull m q J L)
    (hdiam : ∀ i ∈ J, ∀ j ∈ J, dist (q i) (q j) ≤ r)
    {i j : Label} (hi : i ∈ J) (hj : j ∈ J) :
    |externalConfiguration m q J j 1 - externalConfiguration m q J i 1| ≤ L * r := by
  have hc := PiLp.dist_apply_le
    (externalField m q J (q j)) (externalField m q J (q i)) (1 : Axis)
  have hf := hLip (q j) (body_mem_hull q J hj) (q i) (body_mem_hull q J hi)
  have hd := mul_le_mul_of_nonneg_left (hdiam j hj i hi) hL
  have hc' : |externalConfiguration m q J j 1 - externalConfiguration m q J i 1| ≤
      dist (externalField m q J (q j)) (externalField m q J (q i)) := by
    simpa only [Real.dist_eq, externalConfiguration] using hc
  exact hc'.trans (hf.trans hd)

theorem external_mean_difference_lower {m : Masses} (hm : PositiveMasses m)
    {q : Configuration} {J A : Finset Label} (hAJ : A ⊆ J)
    (hA : A.Nonempty) (hB : (J \ A).Nonempty) {L r : ℝ} (hL : 0 ≤ L)
    (hLip : LipschitzOnHull m q J L)
    (hdiam : ∀ i ∈ J, ∀ j ∈ J, dist (q i) (q j) ≤ r) :
    -(L * r) ≤ cutMean m (externalConfiguration m q J) 1 (J \ A) -
      cutMean m (externalConfiguration m q J) 1 A := by
  apply mean_difference_lower hm _ 1 hA hB
  intro i hi j hj
  exact (abs_le.mp (external_coordinate_difference_bound hL hLip hdiam
    (hAJ hi) (Finset.mem_sdiff.mp hj).1)).1

theorem external_mean_difference_abs {m : Masses} (hm : PositiveMasses m)
    {q : Configuration} {J A : Finset Label} (hAJ : A ⊆ J)
    (hA : A.Nonempty) (hB : (J \ A).Nonempty) {L r : ℝ} (hL : 0 ≤ L)
    (hLip : LipschitzOnHull m q J L)
    (hdiam : ∀ i ∈ J, ∀ j ∈ J, dist (q i) (q j) ≤ r) :
    |cutMean m (externalConfiguration m q J) 1 (J \ A) -
      cutMean m (externalConfiguration m q J) 1 A| ≤ L * r := by
  apply abs_le.mpr
  constructor
  · exact external_mean_difference_lower hm hAJ hA hB hL hLip hdiam
  · apply mean_difference_upper hm _ 1 hA hB
    intro i hi j hj
    exact (abs_le.mp (external_coordinate_difference_bound hL hLip hdiam
      (hAJ hi) (Finset.mem_sdiff.mp hj).1)).2

theorem force_factor_cluster_lower {r d g v : ℝ} (_hr : 0 < r) (hd : 0 < d)
    (hg : 0 ≤ g) (hgv : g ≤ v) (hdr : d ≤ r) :
    g / r ^ 3 ≤ v / d ^ 3 := by
  have hp : d ^ 3 ≤ r ^ 3 := pow_le_pow_left₀ hd.le hdr 3
  calc
    g / r ^ 3 ≤ g / d ^ 3 := div_le_div_of_nonneg_left hg (pow_pos hd 3) hp
    _ ≤ v / d ^ 3 := div_le_div_of_nonneg_right hgv (pow_pos hd 3).le

theorem internalCrossForce_lower {m : Masses} (hm : PositiveMasses m)
    {q : Configuration} (hq : CollisionFree q) {J A : Finset Label} (hAJ : A ⊆ J)
    {r g : ℝ} (hr : 0 < r) (hg : 0 < g)
    (hdiam : ∀ i ∈ J, ∀ j ∈ J, dist (q i) (q j) ≤ r)
    (hgap : ∀ i ∈ A, ∀ j ∈ J \ A, g ≤ q j 1 - q i 1) :
    cutMass m A * cutMass m (J \ A) * g / r ^ 3 ≤
      internalCrossForce m q 1 J A := by
  calc
    cutMass m A * cutMass m (J \ A) * g / r ^ 3 =
        ∑ i ∈ A, ∑ j ∈ J \ A, m i * m j * (g / r ^ 3) := by
      rw [← double_cut_mass]
      simp only [Finset.sum_mul, Finset.sum_div, mul_div_assoc]
    _ ≤ internalCrossForce m q 1 J A := by
      apply Finset.sum_le_sum
      intro i hi
      apply Finset.sum_le_sum
      intro j hj
      have hij : i ≠ j := by
        intro heq
        exact (Finset.mem_sdiff.mp hj).2 (heq ▸ hi)
      have hd : 0 < dist (q i) (q j) := collisionFree_dist_pos hq hij
      have hb := force_factor_cluster_lower hr hd hg.le (hgap i hi j hj)
        (hdiam i (hAJ hi) j (Finset.mem_sdiff.mp hj).1)
      calc
        m i * m j * (g / r ^ 3) ≤ m i * m j * ((q j 1 - q i 1) / dist (q i) (q j) ^ 3) :=
          mul_le_mul_of_nonneg_left hb (mul_nonneg (hm i).le (hm j).le)
        _ = (m i * m j / dist (q i) (q j) ^ 3) * (q j 1 - q i 1) := by ring

theorem internal_term_lower {m : Masses} (hm : PositiveMasses m)
    {q : Configuration} (hq : CollisionFree q) {J A : Finset Label} (hAJ : A ⊆ J)
    (hA : A.Nonempty) (hB : (J \ A).Nonempty) {r g : ℝ} (hr : 0 < r) (hg : 0 < g)
    (hdiam : ∀ i ∈ J, ∀ j ∈ J, dist (q i) (q j) ≤ r)
    (hgap : ∀ i ∈ A, ∀ j ∈ J \ A, g ≤ q j 1 - q i 1) :
    cutMass m J * g / r ^ 3 ≤
      (1 / cutMass m A + 1 / cutMass m (J \ A)) * internalCrossForce m q 1 J A := by
  have hMA := cutMass_pos hm hA
  have hMB := cutMass_pos hm hB
  have hcoef : 0 ≤ 1 / cutMass m A + 1 / cutMass m (J \ A) :=
    add_nonneg (one_div_pos.mpr hMA).le (one_div_pos.mpr hMB).le
  calc
    cutMass m J * g / r ^ 3 =
        (1 / cutMass m A + 1 / cutMass m (J \ A)) *
          (cutMass m A * cutMass m (J \ A) * g / r ^ 3) := by
      rw [← mass_partition m J A hAJ]
      field_simp [ne_of_gt hMA, ne_of_gt hMB, ne_of_gt hr]
      ring
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (internalCrossForce_lower hm hq hAJ hr hg hdiam hgap) hcoef

/-- The vertical cluster estimate before choosing the finite gap. Its gap
and mean assumptions are supplied by the constructed subset partition in
the final theorem below, not by the target scale estimate. -/
theorem vertical_bound_from_cut {m : Masses} (hm : PositiveMasses m)
    {q : Configuration} {s : ℝ} (hq : IsSolution m s q)
    {J A : Finset Label} (hAJ : A ⊆ J) (hA : A.Nonempty)
    (hB : (J \ A).Nonempty) {r h g L : ℝ} (hr : 0 < r) (hh : 0 < h)
    (hg : 0 < g) (hthree : h ≤ 3 * g) (hL : 0 ≤ L)
    (hLip : LipschitzOnHull m q J L)
    (hdiam : ∀ i ∈ J, ∀ j ∈ J, dist (q i) (q j) ≤ r)
    (hgap : ∀ i ∈ A, ∀ j ∈ J \ A, g ≤ q j 1 - q i 1)
    (hspan : ∀ i ∈ A, ∀ j ∈ J \ A, q j 1 - q i 1 ≤ h) :
    cutMass m J ≤ 3 * r ^ 3 + 3 * L * r ^ 4 / h := by
  have hmean := mean_difference_upper hm q 1 hA hB hspan
  have hexternal := external_mean_difference_lower hm hAJ hA hB hL hLip hdiam
  have hbalance := mean_vertical_equation hq J A hAJ
  have hinter := internal_term_lower hm hq.1 hAJ hA hB hr hg hdiam hgap
  have hforce : cutMass m J * g / r ^ 3 ≤ h + L * r := by linarith
  have hcubic : cutMass m J * g ≤ (h + L * r) * r ^ 3 :=
    (div_le_iff₀ (pow_pos hr 3)).mp hforce
  have hJ : J.Nonempty := hA.mono hAJ
  have hmass : 0 < cutMass m J := cutMass_pos hm hJ
  have hscale : cutMass m J * h ≤ 3 * ((h + L * r) * r ^ 3) := by
    have hgrowth := mul_le_mul_of_nonneg_left hthree hmass.le
    nlinarith
  have hquotient : cutMass m J ≤ (3 * r ^ 3 * h + 3 * L * r ^ 4) / h := by
    apply (le_div_iff₀ hh).mpr
    calc
      cutMass m J * h ≤ 3 * ((h + L * r) * r ^ 3) := hscale
      _ = 3 * r ^ 3 * h + 3 * L * r ^ 4 := by ring
  calc
    cutMass m J ≤ (3 * r ^ 3 * h + 3 * L * r ^ 4) / h := hquotient
    _ = 3 * r ^ 3 + 3 * L * r ^ 4 / h := by
      field_simp [ne_of_gt hh]

/-- Actual v2 vertical cluster bound for a nonempty subset of the original
four labels with positive vertical diameter. The cut, its nonempty sides,
the positive gap, and all mean-range hypotheses are constructed internally.
The radius parameter is a genuine bound on all actual pair distances in J;
in particular the theorem applies to the attained cluster diameter. -/
theorem vertical_cluster_bound {m : Masses} (hm : PositiveMasses m)
    {q : Configuration} {s : ℝ} (hq : IsSolution m s q)
    (J : Finset Label) (hJ : J.Nonempty) {r L : ℝ} (hr : 0 < r) (hL : 0 ≤ L)
    (hLip : LipschitzOnHull m q J L)
    (hdiam : ∀ i ∈ J, ∀ j ∈ J, dist (q i) (q j) ≤ r)
    (hh : 0 < clusterCoordinateDiameter J (fun i => q i 1) hJ) :
    cutMass m J ≤ 3 * r ^ 3 +
      3 * L * r ^ 4 / clusterCoordinateDiameter J (fun i => q i 1) hJ := by
  rcases cluster_largest_gap_partition J (fun i => q i 1) hJ hh with
    ⟨A, B, g, hAJ, _hBJ, hA, hB, hBdef, _hdisj, _hcover, hg, hthree, hgap⟩
  have hB' : (J \ A).Nonempty := by simpa only [hBdef] using hB
  have hgap' : ∀ i ∈ A, ∀ j ∈ J \ A, g ≤ q j 1 - q i 1 := by
    simpa only [hBdef] using hgap
  have hspan : ∀ i ∈ A, ∀ j ∈ J \ A,
      q j 1 - q i 1 ≤ clusterCoordinateDiameter J (fun i => q i 1) hJ := by
    intro i hi j hj
    exact cluster_coordinate_difference_le_diameter J (fun i => q i 1) hJ i j
      (hAJ hi) (Finset.mem_sdiff.mp hj).1
  exact vertical_bound_from_cut hm hq hAJ hA hB' hr hh hg hthree hL hLip hdiam hgap' hspan

theorem externalField_univ (m : Masses) (q : Configuration) (z : Point) :
    externalField m q Finset.univ z = 0 := by
  simp [externalField, cutComplement]

theorem lipschitzOnHull_univ_zero (m : Masses) (q : Configuration) :
    LipschitzOnHull m q Finset.univ 0 := by
  intro z hz w hw
  simp [externalField_univ]

/-- The field in the actual body equations is the already verified physical
Newton field. This is a definition-level equality, with the actual sign. -/
theorem externalField_eq_exteriorNewtonForce (m : Masses) (q : Configuration)
    (J : Finset Label) (z : Point) :
    externalField m q J z = Reuse.exteriorNewtonForce (cutComplement J) m q z := rfl

/-- Actual NewtonBounds supply the auxiliary Lipschitz hypothesis from
separation on the convex hull. The geometric source of this hull separation
is provided separately by ExternalClusterBounds. -/
theorem lipschitzOnHull_of_separated {m : Masses} (hm : PositiveMasses m)
    (q : Configuration) (J : Finset Label) {δ : ℝ} (hδ : 0 < δ)
    (hseparation : ∀ z ∈ hull q J, ∀ j ∈ cutComplement J,
      δ / 2 ≤ dist z (q j)) :
    LipschitzOnHull m q J (16 * (totalMass m - cutMass m J) / δ ^ 3) := by
  intro z hz w hw
  have hmass : (∑ j ∈ cutComplement J, m j) = totalMass m - cutMass m J := by
    have h := cutMass_complement m J
    unfold cutMass at h ⊢
    linarith
  have hb := Reuse.exteriorNewtonForce_sub_norm_bound_on_convex
    (cutComplement J) m q (hull q J) δ (fun j _ => (hm j).le) hδ
    (convex_convexHull ℝ _) hseparation z w hz hw
  simpa only [externalField_eq_exteriorNewtonForce, dist_eq_norm, hmass] using hb

/-- The explicit vertical estimate using the paper's actual external mass
and sharp constant 16. Only geometric separation remains as an auxiliary
premise here; the Lipschitz estimate is proved from the true Newton field. -/
theorem vertical_cluster_bound_of_hull_separation {m : Masses} (hm : PositiveMasses m)
    {q : Configuration} {s : ℝ} (hq : IsSolution m s q)
    (J : Finset Label) (hJ : J.Nonempty) {r δ : ℝ} (hr : 0 < r) (hδ : 0 < δ)
    (hseparation : ∀ z ∈ hull q J, ∀ j ∈ cutComplement J,
      δ / 2 ≤ dist z (q j))
    (hdiam : ∀ i ∈ J, ∀ j ∈ J, dist (q i) (q j) ≤ r)
    (hh : 0 < clusterCoordinateDiameter J (fun i => q i 1) hJ) :
    cutMass m J ≤ 3 * r ^ 3 +
      3 * (16 * (totalMass m - cutMass m J) / δ ^ 3) * r ^ 4 /
        clusterCoordinateDiameter J (fun i => q i 1) hJ := by
  have hmass : 0 ≤ totalMass m - cutMass m J := by
    have h := cutMass_complement m J
    have hp : 0 ≤ cutMass m (cutComplement J) :=
      Finset.sum_nonneg (fun j _ => (hm j).le)
    linarith
  have hL : 0 ≤ 16 * (totalMass m - cutMass m J) / δ ^ 3 :=
    div_nonneg (mul_nonneg (by norm_num) hmass) (pow_nonneg hδ.le 3)
  exact vertical_cluster_bound hm hq J hJ hr hL
    (lipschitzOnHull_of_separated hm q J hδ hseparation) hdiam hh

/-- The full-cluster case requires no exterior separation. -/
theorem vertical_full_cluster_bound {m : Masses} (hm : PositiveMasses m)
    {q : Configuration} {s : ℝ} (hq : IsSolution m s q) {r : ℝ} (hr : 0 < r)
    (hdiam : ∀ i, ∀ j, dist (q i) (q j) ≤ r)
    (hh : 0 < clusterCoordinateDiameter Finset.univ (fun i => q i 1) Finset.univ_nonempty) :
    totalMass m ≤ 3 * r ^ 3 := by
  have hb := vertical_cluster_bound hm hq Finset.univ Finset.univ_nonempty
    hr (le_refl 0) (lipschitzOnHull_univ_zero m q) (fun i _ j _ => hdiam i j) hh
  simpa only [cutMass, totalMass, mul_zero, zero_mul, zero_div, add_zero] using hb

end FourBody.ClusterVertical
